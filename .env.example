# Copy this file to .env and fill in your values.
# .env contains your password: never share it or upload it anywhere.

POS_DB_HOST=127.0.0.1
POS_DB_PORT=3306
POS_DB_NAME=convenience_store_pos
POS_DB_USER=pos_app
# Leave empty ONLY if this MySQL account really has no password.
POS_DB_PASSWORD=
# Encryption to MySQL. Keep "off" when MySQL is on this same computer (XAMPP).
POS_DB_SSL=off

POS_STORE_NAME=My Convenience Store
POS_CURRENCY_SYMBOL=₱
POS_LOG_LEVEL=INFO
POS_LOG_DIR=logs
POS_BACKUP_DIR=backups
# Folder with mysqldump.exe (used for backups in a later phase)
POS_MYSQL_BIN_DIR=C:\xampp\mysql\bin
